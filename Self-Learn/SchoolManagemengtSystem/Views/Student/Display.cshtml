@model IEnumerable<SchoolManagemengtSystem.Models.StudentModel>

@{
    ViewData["Title"] = "Student List";
}

<div class="container mt-4">
    <h2 class="mb-3">Student List</h2>

    <a asp-action="Add" class="btn btn-primary mb-3">
        Add New Student
    </a>

    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Student ID</th>
                <th>Name</th>
                <th>Branch</th>
                <th>Email</th>
                <th>Date of Birth</th>
                <th>City</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.studentId</td>
                        <td>@item.studentName</td>
                        <td>@item.studentBranch</td>
                        <td>@item.studentEmail</td>
                        <td>@item.studentDob.ToString("dd-MM-yyyy")</td>
                        <td>@item.studentCity</td>

                        <!-- Actions Column on Right -->
                        <td class="text-center">
                            <a asp-action="Update"
                               asp-route-id="@item.studentId"
                               class="btn btn-sm btn-warning">
                                Update
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.studentId"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Are you sure you want to delete this student?');">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-danger">
                        No Students Found
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>