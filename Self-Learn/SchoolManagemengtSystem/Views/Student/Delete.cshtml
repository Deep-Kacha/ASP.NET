@model SchoolManagemengtSystem.Models.StudentModel

<h2 class="text-danger">Delete Student</h2>

<h4>Are you sure you want to delete this student?</h4>

<div class="card p-3 mt-3">
    <p><strong>ID:</strong> @Model.studentId</p>
    <p><strong>Name:</strong> @Model.studentName</p>
    <p><strong>Branch:</strong> @Model.studentBranch</p>
    <p><strong>Email:</strong> @Model.studentEmail</p>
    <p><strong>DOB:</strong> @Model.studentDob.ToString("dd-MM-yyyy")</p>
    <p><strong>City:</strong> @Model.studentCity</p>
</div>

<form asp-action="DeleteConfirmed" method="post" class="mt-3">
    <input type="hidden" asp-for="studentId" />

    <button type="submit" class="btn btn-danger">
        Yes, Delete
    </button>

    <a asp-action="Display" class="btn btn-secondary">
        Cancel
    </a>
</form>