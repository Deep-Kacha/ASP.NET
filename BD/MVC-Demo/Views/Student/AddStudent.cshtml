@model MVC_Demo.Models.Student

@{
    ViewBag.Title = "AddStudent";
}

<h2>Add / Update Student</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@using (Html.BeginForm("AddStudent", "Student", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-floating mb-3">
        @Html.TextBoxFor(m => m.studentname, new { @class = "form-control" })
        <label>Student Name</label>
        @Html.ValidationMessageFor(m => m.studentname, "", new { @class = "text-danger" })
    </div>

    <div class="form-floating mb-3">
        @Html.TextBoxFor(m => m.studentcity, new { @class = "form-control" })
        <label>Student City</label>
        @Html.ValidationMessageFor(m => m.studentcity, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary btn-sm">
        Save
    </button>
}
